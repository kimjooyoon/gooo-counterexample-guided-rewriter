{
  "schema": "gooo/counterexample-guided-rewriter/metrics/v1",
  "inventory_excludes": ["README.md", ".git"],
  "integer_fields": [
    "go_files", "gooo_files", "physical_lines", "descendant_dirs", "regular_files",
    "generated_files", "generated_bytes", "wall_ms", "peak_rss_kib",
    "candidate_gooo_files", "candidate_ir_files", "candidate_patch_files", "candidate_dossier_files", "case_report_files", "causal_input_files",
    "tests_total", "tests_selected", "tests_executed", "tests_reused", "tests_failed", "tests_unknown",
    "proof_closed", "proof_unknown", "proof_refuted", "indicator_closed", "indicator_unknown", "indicator_refuted",
    "external_utility_unknown", "local_test_executions", "cross_project_required_gates"
  ],
  "integer_or_null_fields": ["build_ms", "test_ms", "cache_hits", "cache_misses"],
  "nullable_fields_require_unknown": true,
  "test_semantics": "fixed counterexample denominator and exact paired before-after indicators",
  "generated_artifacts": ["causal-input.json", "candidate-*.gooo", "candidate-*.ir.json", "candidate-*.patch.json", "candidate-*.dossier.json", "case-report.json", "conformance-report.json", "semantic-metrics-dossier.json", "metrics.json", "release-evidence.json"],
  "paired_indicator_vector": "exact per-cell before/after evaluator evidence",
  "forbidden_aggregates": ["score", "percentage"],
  "repository_writes": 0
}
